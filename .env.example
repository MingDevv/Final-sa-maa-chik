# การเชื่อมต่อ PostgreSQL (จำเป็น)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/final_exam_prep"

# รหัสผ่านผู้ดูแลระบบ (Admin) — ต้องตั้งค่าเอง ถ้าไม่ตั้งจะล็อกอินหน้า /admin ไม่ได้
ADMIN_CODE="ตั้งรหัสของคุณเอง"

# การจัดเก็บไฟล์ (local = บันทึกลงโฟลเดอร์ uploads, s3 = AWS S3 / Cloudflare R2)
STORAGE_DRIVER="local"

# ถ้าใช้ S3
# S3_BUCKET="my-bucket"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE=""

# URL ของเว็บแอป (สำหรับ OpenGraph / Metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
